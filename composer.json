{
  "name": "ucsp/lab6-hospital",
  "description": "Capa adaptadora para pruebas unitarias y dobles en proyecto Hospital UCSP",
  "type": "project",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Farmacia\\": "main/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Farmacia\\Tests\\": "test/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  }
}
